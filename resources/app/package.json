{
  "name": "solvex",
  "version": "1.0.0",
  "productName": "Solvex",
  "description": "钱包连接、链上 USDT 充值、平台内部现货与永续合约交易及原钱包提现。",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "dev:local": "node scripts/dev-local.mjs",
    "build:frontend": "node scripts/build-frontend.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json",
    "test:frontend": "npm run typecheck && npm run build:frontend && node scripts/preview-solvex-react.mjs",
    "preview:ui": "node scripts/serve-solvex-preview.mjs",
    "test:model": "node test/solvex-model.test.js && node test/a-token-upgrade.test.js && node test/market-catalog.test.js",
    "test:runtime": "node scripts/check-local-runtime.mjs",
    "test:local": "npm run test:model && npm run test:frontend && npm run test:runtime && node test/mobile-static-cache.test.js && node test/i18n.test.js",
    "test:asset-reporting": "node test/a-token-asset-reporting.test.js",
    "test:assets-wallet-balance": "node test/assets-wallet-balance.test.js",
    "test:page-loading": "node scripts/verify-all-page-loading.mjs --fixtures",
    "test:svx-chart": "node test/a-token-chart.test.js",
    "test:admin-speed": "node test/admin-speed.test.js && node test/admin-speed-browser.test.js",
    "build:wallet": "node scripts/build-wallet.js",
    "prestart": "npm run build:wallet && npm run build:frontend",
    "start": "node scripts/dev-local.mjs",
    "test": "npm run test:local",
    "test:admin-security": "node test/admin-security.test.js && node test/funds-permissions.test.js && node test/admin-security-browser.test.js",
    "test:claim-security": "node test/a-token-claim-security.test.js && node test/a-token-withdrawal-security.test.js",
    "test:device-limit": "node test/device-limit.test.js",
    "test:solvex": "node test/solvex-model.test.js && node test/solvex-finance.test.js && node test/solvex-groups.test.js && node test/solvex-withdrawal.test.js",
    "test:auto-lp": "node test/auto-lp-contract.test.js && node test/a-token-lp-job.test.js",
    "test:solvex-ui": "node test/solvex-ui.test.js",
    "test:team": "node test/team-navigation.test.js",
    "test:hardening": "node test/platform-hardening.test.js && node test/a-token-upgrade.test.js && node test/atomic-ledger.test.js",
    "test:ledger-ops": "node scripts/check-ledger-ops.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ethers": "^6.17.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "undici": "^6.28.1"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.25.9",
    "puppeteer": "^25.10.0",
    "solc": "0.8.20",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^7.3.8"
  },
  "overrides": {
    "tmp": "^0.2.7"
  }
}
